+/// Build a `Document` for PDFs.  Text blocks come from pdf-inspector's
+/// markdown (split on blank lines).  Images come from `pdf_images::extract_images`.
+/// When there is no text but images exist, the document contains only image
+/// blocks so that `anydoc_assets` / `--imgs` can still emit bytes.
+pub fn to_document(bytes: &[u8]) -> Result<Document, ConvertError> {
+    let (markdown, page_count, pdf_type) = extract_text(bytes)?;
+    let raw_images = crate::formats::pdf_images::extract_images(bytes);
+    if markdown.is_none() && raw_images.is_empty() {
+        return Err(ConvertError::Unsupported(format!(
+            "PDF has no extractable text ({:?}, {} pages): OCR is required",
+            pdf_type, page_count
+        )));
+    }
+    let mut sink = AssetSink::new();
+    let mut assets: Vec<Asset> = Vec::new();
+    for (idx, img) in raw_images.into_iter().enumerate() {
+        let ext = match img.media_type.as_str() {
+            "image/jpeg" => "jpg",
+            "image/jp2" => "jp2",
+            "image/png" => "png",
+            "image/tiff" => "tiff",
+            _ => "bin",
+        };
+        let origin = format!("pdf/image-{idx}.{ext}");
+        let id = sink.add(img.media_type.clone(), origin.clone(), &img.bytes)?;
+        assets.push(Asset { id, media_type: img.media_type, origin_part: origin, bytes: img.bytes });
+    }
+    let mut blocks: Vec<Block> = Vec::new();
+    if let Some(md) = markdown {
+        for para in md.split("\n\n") {
+            let t = para.trim();
+            if t.is_empty() {
+                continue;
+            }
+            blocks.push(Block::Paragraph(vec![Inline::Text { text: t.to_string(), style: crate::model::Style::PLAIN }]));
+        }
+    }
+    for asset in &assets {
+        blocks.push(Block::Paragraph(vec![Inline::Image { alt: String::new(), source: ImageSource::Asset(asset.id) }]));
+    }
+    Ok(Document { blocks, notes: Vec::new(), assets })
+}
