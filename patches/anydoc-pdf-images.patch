+//! PDF image extraction via lopdf.
+//!
+//! Scans all `Subtype == Image` streams in the document and produces
+//! `RawImage` entries with decoded bytes and a media type.
+//! Filter handling:
+//! - `DCTDecode` / `DCT`  -> `image/jpeg`  (passthrough after decoding
+//!   preceding ASCII85/LZW/RunLength)
+//! - `JPXDecode`          -> `image/jp2`   (same passthrough)
+//! - `FlateDecode` (+ optional `ASCII85Decode`) -> decompress via
+//!   `lopdf::Stream::decompressed_content` and encode to PNG (RGB/Gray 8bpc
+//!   MVP; other ColorSpace/BPC are skipped with a warn)
+//! - `CCITTFaxDecode` / `CCF` -> decode via `hayro-ccitt` then encode PNG
+//! - `JBIG2Decode` / `JB2Decode` -> decode via `hayro-jbig2` (with optional
+//!   `JBIG2Globals`) then encode PNG
+//! - `LZWDecode`, `RunLengthDecode` alone are currently skipped (log warn).
+//! `Inline` BI/EI images are not enumerated (out of scope for this patch).
+
+use lopdf::{Dictionary, Document, Object, Stream};
+
+#[derive(Debug, Clone)]
+pub struct RawImage {
+    pub bytes: Vec<u8>,
+    pub media_type: String,
+    pub width: u32,
+    pub height: u32,
+}
+
+/// Decode ASCII85 (Adobe variant, supports `z` and `~>` EOD).
+/// Copied from lopdf's private `Stream::decode_ascii85` to avoid relying on
+/// private API. Returns `Err` on overflow/illegal char.
+fn decode_ascii85(input: &[u8]) -> Result<Vec<u8>, String> {
+    let mut output = Vec::new();
+    let mut buffer: u32 = 0;
+    let mut count: u32 = 0;
+
+    // Strip EOD marker if present
+    let input_no_eod = if input.len() >= 2 && &input[input.len() - 2..] == b"~>" {
+        &input[..input.len() - 2]
+    } else {
+        input
+    };
+
+    for &ch in input_no_eod {
+        if ch == b'z' {
+            if count != 0 {
+                return Err("z in middle of group".into());
+            }
+            output.extend_from_slice(&[0u8, 0, 0, 0]);
+            continue;
+        }
+        if ch.is_ascii_whitespace() {
+            continue;
+        }
+        if !(b'!'..=b'u').contains(&ch) {
+            break;
+        }
+        buffer = buffer
+            .checked_mul(85)
+            .ok_or_else(|| "ascii85 mul overflow".to_string())?;
+        buffer += (ch - b'!') as u32;
+        count += 1;
+        if count == 5 {
+            output.extend_from_slice(&buffer.to_be_bytes());
+            buffer = 0;
+            count = 0;
+        }
+    }
+    if count > 0 {
+        for _ in count..5 {
+            buffer = buffer
+                .checked_mul(85)
+                .ok_or_else(|| "ascii85 mul overflow tail".to_string())?;
+            buffer += 84;
+        }
+        let bytes = buffer.to_be_bytes();
+        output.extend_from_slice(&bytes[..(count as usize - 1)]);
+    }
+    Ok(output)
+}
+
+fn get_filter_names(dict: &Dictionary) -> Vec<Vec<u8>> {
+    let Ok(filter_obj) = dict.get(b"Filter") else {
+        return Vec::new();
+    };
+    if let Ok(name) = filter_obj.as_name() {
+        return vec![name.to_vec()];
+    }
+    if let Ok(arr) = filter_obj.as_array() {
+        let mut out = Vec::new();
+        for item in arr {
+            if let Ok(name) = item.as_name() {
+                out.push(name.to_vec());
+            }
+        }
+        return out;
+    }
+    Vec::new()
+}
+
+fn filter_contains(filters: &[Vec<u8>], needle: &[u8]) -> bool {
+    filters.iter().any(|f| f.as_slice() == needle)
+}
+
+fn filter_index(filters: &[Vec<u8>], needle: &[u8]) -> Option<usize> {
+    filters.iter().position(|f| f.as_slice() == needle)
+}
+
+/// Encode raw RGB or Gray bytes to a minimal PNG (8bpc, no interlace).
+/// `data` must be `w*h*channels` bytes, row-major, 8 bits per sample.
+/// `channels`: 1 = Gray, 3 = RGB, 4 = RGBA.
+/// Uses `flate2` Zlib + `crc32fast` if available, otherwise hand-rolled CRC.
+fn encode_png(w: u32, h: u32, data: &[u8], channels: usize) -> Option<Vec<u8>> {
+    let color_type: u8 = match channels {
+        1 => 0, // Grey
+        3 => 2, // RGB
+        4 => 6, // RGBA
+        _ => return None,
+    };
+    // Build filtered rows (filter type 0 per row)
+    let row_len = w as usize * channels;
+    if data.len() < row_len * h as usize {
+        return None;
+    }
+    let mut raw = Vec::with_capacity((row_len + 1) * h as usize);
+    for y in 0..h as usize {
+        raw.push(0u8);
+        raw.extend_from_slice(&data[y * row_len..(y + 1) * row_len]);
+    }
+    // Deflate
+    let compressed = {
+        use flate2::write::ZlibEncoder;
+        use flate2::Compression;
+        use std::io::Write;
+        let mut enc = ZlibEncoder::new(Vec::new(), Compression::default());
+        if enc.write_all(&raw).is_err() {
+            return None;
+        }
+        match enc.finish() {
+            Ok(v) => v,
+            Err(_) => return None,
+        }
+    };
+
+    // CRC helper: use crc32fast if we can, else fallback is not needed because
+    // crc32fast is available via flate2's transitive dep; we vendor a tiny one.
+    fn crc32(data: &[u8]) -> u32 {
+        const TABLE: [u32; 256] = {
+            let mut t = [0u32; 256];
+            let mut i = 0usize;
+            while i < 256 {
+                let mut c = i as u32;
+                let mut k = 0;
+                while k < 8 {
+                    if c & 1 != 0 {
+                        c = 0xEDB88320u32 ^ (c >> 1);
+                    } else {
+                        c >>= 1;
+                    }
+                    k += 1;
+                }
+                t[i] = c;
+                i += 1;
+            }
+            t
+        };
+        let mut crc = 0xFFFF_FFFFu32;
+        for &b in data {
+            let idx = ((crc ^ b as u32) & 0xFF) as usize;
+            crc = TABLE[idx] ^ (crc >> 8);
+        }
+        !crc
+    }
+
+    let mut out = Vec::new();
+    out.extend_from_slice(b"\x89PNG\r\n\x1a\n");
+    // IHDR
+    {
+        let mut ihdr_data = Vec::with_capacity(13);
+        ihdr_data.extend_from_slice(&w.to_be_bytes());
+        ihdr_data.extend_from_slice(&h.to_be_bytes());
+        ihdr_data.push(8u8); // bit depth
+        ihdr_data.push(color_type);
+        ihdr_data.push(0); // compression
+        ihdr_data.push(0); // filter
+        ihdr_data.push(0); // interlace
+        let mut chunk = Vec::new();
+        chunk.extend_from_slice(b"IHDR");
+        chunk.extend_from_slice(&ihdr_data);
+        let crc = crc32(&chunk);
+        out.extend_from_slice(&(13u32.to_be_bytes()));
+        out.extend_from_slice(&chunk);
+        out.extend_from_slice(&crc.to_be_bytes());
+    }
+    // IDAT
+    {
+        let mut chunk = Vec::new();
+        chunk.extend_from_slice(b"IDAT");
+        chunk.extend_from_slice(&compressed);
+        let crc = crc32(&chunk);
+        out.extend_from_slice(&(compressed.len() as u32).to_be_bytes());
+        out.extend_from_slice(&chunk);
+        out.extend_from_slice(&crc.to_be_bytes());
+    }
+    // IEND
+    {
+        let mut chunk = Vec::new();
+        chunk.extend_from_slice(b"IEND");
+        let crc = crc32(&chunk);
+        out.extend_from_slice(&0u32.to_be_bytes());
+        out.extend_from_slice(&chunk);
+        out.extend_from_slice(&crc.to_be_bytes());
+    }
+    Some(out)
+}
+
+fn get_u32(dict: &Dictionary, key: &[u8]) -> Option<u32> {
+    dict.get(key)
+        .ok()
+        .and_then(|o| o.as_i64().ok())
+        .and_then(|v| u32::try_from(v).ok())
+}
+
+fn get_bool(dict: &Dictionary, key: &[u8]) -> Option<bool> {
+    dict.get(key).ok().and_then(|o| o.as_bool().ok())
+}
+
+fn get_i32(dict: &Dictionary, key: &[u8]) -> Option<i32> {
+    dict.get(key)
+        .ok()
+        .and_then(|o| o.as_i64().ok())
+        .and_then(|v| i32::try_from(v).ok())
+}
+
+fn get_colorspace_name(dict: &Dictionary) -> String {
+    if let Ok(cs) = dict.get(b"ColorSpace") {
+        if let Ok(name) = cs.as_name() {
+            return String::from_utf8_lossy(name).to_string();
+        }
+        if let Ok(arr) = cs.as_array() {
+            if let Some(first) = arr.first() {
+                if let Ok(name) = first.as_name() {
+                    // e.g. [ /Indexed /DeviceRGB 255 <lookup> ]
+                    if name == b"Indexed" {
+                        return "Indexed".to_string();
+                    }
+                    return String::from_utf8_lossy(name).to_string();
+                }
+            }
+        }
+    }
+    String::new()
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum BaseKind { Gray, Rgb, Cmyk }
+
+struct IndexedInfo {
+    base: BaseKind,
+    hival: u8,
+    lookup: Vec<u8>,
+}
+
+fn base_components(base: BaseKind) -> usize {
+    match base { BaseKind::Gray => 1, BaseKind::Rgb => 3, BaseKind::Cmyk => 4 }
+}
+
+fn parse_base_name(name: &[u8]) -> Option<BaseKind> {
+    match name {
+        b"DeviceRGB" | b"RGB" => Some(BaseKind::Rgb),
+        b"DeviceGray" | b"Gray" | b"DeviceGrey" | b"Grey" => Some(BaseKind::Gray),
+        b"DeviceCMYK" | b"CMYK" => Some(BaseKind::Cmyk),
+        _ => None,
+    }
+}
+
+fn resolve_lookup_bytes(doc: &Document, obj: &Object) -> Option<Vec<u8>> {
+    let (_, resolved) = doc.dereference(obj).ok()?;
+    match resolved {
+        Object::String(s, _) => Some(s.clone()),
+        Object::Stream(s) => decoded_stream_bytes(s),
+        Object::Reference(id) => {
+            if let Ok(Object::Stream(s)) = doc.get_object(*id) {
+                return decoded_stream_bytes(s);
+            }
+            None
+        }
+        _ => {
+            // Fallback: obj itself may be Reference not dereferenced to String/Stream
+            if let Ok(oid) = obj.as_reference() {
+                if let Ok(Object::Stream(s)) = doc.get_object(oid) {
+                    return decoded_stream_bytes(s);
+                }
+                if let Ok(Object::String(ss2, _)) = doc.get_object(oid) {
+                    return Some(ss2.clone());
+                }
+            }
+            None
+        }
+    }
+}
+
+fn parse_indexed(doc: &Document, dict: &Dictionary) -> Option<IndexedInfo> {
+    let cs_obj = dict.get(b"ColorSpace").ok()?;
+    let (_, cs_resolved) = doc.dereference(cs_obj).ok()?;
+    let arr = match cs_resolved {
+        Object::Array(a) => a,
+        _ => return None,
+    };
+    if arr.len() < 4 { return None; }
+    let first = arr[0].as_name().ok()?;
+    if first != b"Indexed" { return None; }
+    // base: Name or Array
+    let base = match &arr[1] {
+        Object::Name(n) => parse_base_name(n).unwrap_or(BaseKind::Rgb),
+        Object::Array(base_arr) => {
+            if let Some(name_obj) = base_arr.first() {
+                if let Ok(name) = name_obj.as_name() {
+                    // ICCBased etc -> fallback to RGB with warn
+                    if name == b"ICCBased" || name == b"Lab" || name == b"Separation" || name == b"DeviceN" {
+                        log::warn!("Indexed base {:?} not fully supported, falling back to RGB", String::from_utf8_lossy(name));
+                        BaseKind::Rgb
+                    } else {
+                        parse_base_name(name).unwrap_or(BaseKind::Rgb)
+                    }
+                } else { BaseKind::Rgb }
+            } else { BaseKind::Rgb }
+        }
+        Object::Reference(id) => {
+            if let Ok(obj) = doc.get_object(*id) {
+                if let Ok(name) = obj.as_name() {
+                    parse_base_name(name).unwrap_or(BaseKind::Rgb)
+                } else { BaseKind::Rgb }
+            } else { BaseKind::Rgb }
+        }
+        _ => BaseKind::Rgb,
+    };
+    let hival = arr[2].as_i64().ok().and_then(|v| u8::try_from(v).ok()).unwrap_or(255);
+    let lookup_obj = &arr[3];
+    let mut lookup = resolve_lookup_bytes(doc, lookup_obj)?;
+    let comps = base_components(base);
+    let expected = (hival as usize + 1) * comps;
+    if lookup.len() < expected {
+        log::warn!("Indexed lookup truncated {} < expected {}, padding", lookup.len(), expected);
+        lookup.resize(expected, 0);
+    } else if lookup.len() > expected {
+        log::warn!("Indexed lookup oversized {} > expected {}, truncating", lookup.len(), expected);
+        lookup.truncate(expected);
+    }
+    if lookup.is_empty() { return None; }
+    Some(IndexedInfo { base, hival, lookup })
+}
+
+fn unpack_indices(data: &[u8], width: u32, height: u32, bpc: u32) -> Option<Vec<u8>> {
+    let w = width as usize;
+    let h = height as usize;
+    let total = w.checked_mul(h)?;
+    if bpc == 8 {
+        if data.len() < total { return None; }
+        return Some(data[..total].to_vec());
+    }
+    if bpc != 1 && bpc != 2 && bpc != 4 {
+        return None;
+    }
+    let row_bytes = (w * bpc as usize + 7) / 8;
+    if data.len() < row_bytes * h { return None; }
+    let mut out = Vec::with_capacity(total);
+    let mask: u32 = (1u32 << bpc) - 1;
+    for y in 0..h {
+        let row = &data[y * row_bytes..(y+1)*row_bytes];
+        let mut bit_pos = 0usize;
+        for _x in 0..w {
+            let byte_idx = bit_pos / 8;
+            let bit_off = bit_pos % 8;
+            // bits are MSB first
+            let shift = 8 - bit_off - bpc as usize;
+            let v = if byte_idx < row.len() {
+                ((row[byte_idx] as u32) >> shift) & mask
+            } else { 0 };
+            out.push(v as u8);
+            bit_pos += bpc as usize;
+        }
+    }
+    Some(out)
+}
+
+fn cmyk_to_rgb_naive(c: u8, m: u8, y: u8, k: u8) -> (u8, u8, u8) {
+    let cf = c as f32 / 255.0;
+    let mf = m as f32 / 255.0;
+    let yf = y as f32 / 255.0;
+    let kf = k as f32 / 255.0;
+    let r = ((1.0 - cf) * (1.0 - kf) * 255.0).round().clamp(0.0, 255.0) as u8;
+    let g = ((1.0 - mf) * (1.0 - kf) * 255.0).round().clamp(0.0, 255.0) as u8;
+    let b = ((1.0 - yf) * (1.0 - kf) * 255.0).round().clamp(0.0, 255.0) as u8;
+    (r, g, b)
+}
+
+fn lookup_to_rgb(indices: &[u8], info: &IndexedInfo, width: u32, height: u32) -> Option<Vec<u8>> {
+    let total = (width as usize) * (height as usize);
+    if indices.len() < total { return None; }
+    let comps = base_components(info.base);
+    // Already validated lookup len == (hival+1)*comps
+    let mut out = Vec::with_capacity(total * 3);
+    for i in 0..total {
+        let idx = (indices[i] as usize).min(info.hival as usize);
+        let off = idx * comps;
+        if off + comps > info.lookup.len() {
+            // clamp to 0
+            match info.base {
+                BaseKind::Gray => { let v = info.lookup[0]; out.extend_from_slice(&[v,v,v]); }
+                BaseKind::Rgb => out.extend_from_slice(&[0,0,0]),
+                BaseKind::Cmyk => out.extend_from_slice(&[0,0,0]),
+            }
+            continue;
+        }
+        match info.base {
+            BaseKind::Gray => {
+                let v = info.lookup[off];
+                out.extend_from_slice(&[v,v,v]);
+            }
+            BaseKind::Rgb => {
+                out.extend_from_slice(&info.lookup[off..off+3]);
+            }
+            BaseKind::Cmyk => {
+                let (r,g,b) = cmyk_to_rgb_naive(info.lookup[off], info.lookup[off+1], info.lookup[off+2], info.lookup[off+3]);
+                out.extend_from_slice(&[r,g,b]);
+            }
+        }
+    }
+    Some(out)
+}
+
+
+/// Try to extract the JPEG/JP2 bytes for a DCT/JPX image by decoding only
+/// the filters *before* the DCT/JPX one. For `[ASCII85, DCT]` this decodes
+/// ASCII85 and returns the JPEG bytes.
+fn extract_passthrough_bytes(stream: &Stream, filters: &[Vec<u8>], passthrough: &[u8]) -> Option<Vec<u8>> {
+    let idx = filter_index(filters, passthrough)?;
+    // Collect preceding filter names
+    let preceding = &filters[..idx];
+    let mut data = stream.content.clone();
+    for f in preceding {
+        match f.as_slice() {
+            b"ASCII85Decode" | b"A85" => match decode_ascii85(&data) {
+                Ok(d) => data = d,
+                Err(e) => {
+                    log::warn!("ASCII85 decode before {:?} failed: {}", String::from_utf8_lossy(passthrough), e);
+                    return None;
+                }
+            },
+            b"FlateDecode" | b"Fl" => {
+                use flate2::read::ZlibDecoder;
+                use std::io::Read;
+                let mut dec = ZlibDecoder::new(data.as_slice());
+                let mut out = Vec::new();
+                if dec.read_to_end(&mut out).is_err() {
+                    log::warn!("Flate before passthrough failed");
+                    return None;
+                }
+                data = out;
+            }
+            b"LZWDecode" | b"LZW" => {
+                log::warn!("LZW before {:?} not supported, skipping image", String::from_utf8_lossy(passthrough));
+                return None;
+            }
+            b"RunLengthDecode" | b"RL" => {
+                log::warn!("RunLength before passthrough not supported");
+                return None;
+            }
+            other => {
+                log::warn!("unsupported preceding filter {:?} before passthrough", String::from_utf8_lossy(other));
+                return None;
+            }
+        }
+    }
+    Some(data)
+}
+
+/// Decode filters that appear *before* the given `target` filter.
+/// Returns the bytes that should be fed to the target decoder.
+/// Currently handles ASCII85 / A85 and empty preceding chain.
+fn decode_ascii_hex(data: &[u8]) -> Option<Vec<u8>> {
+    let mut out = Vec::new();
+    let mut hi: Option<u8> = None;
+    for &c in data {
+        if c.is_ascii_whitespace() {
+            continue;
+        }
+        if c == b'>' {
+            break;
+        }
+        let v = match c {
+            b'0'..=b'9' => c - b'0',
+            b'a'..=b'f' => c - b'a' + 10,
+            b'A'..=b'F' => c - b'A' + 10,
+            _ => return None,
+        };
+        if let Some(h) = hi {
+            out.push((h << 4) | v);
+            hi = None;
+        } else {
+            hi = Some(v);
+        }
+    }
+    if let Some(h) = hi {
+        out.push(h << 4);
+    }
+    Some(out)
+}
+
+fn decode_preceding_filters(stream: &Stream, filters: &[Vec<u8>], target: &[u8]) -> Option<Vec<u8>> {
+    let idx = filter_index(filters, target)?;
+    let preceding = &filters[..idx];
+    if preceding.is_empty() {
+        return Some(stream.content.clone());
+    }
+    let mut data = stream.content.clone();
+    for f in preceding {
+        match f.as_slice() {
+            b"ASCII85Decode" | b"A85" => match decode_ascii85(&data) {
+                Ok(d) => data = d,
+                Err(e) => {
+                    log::warn!("ASCII85 decode before {:?} failed: {}", String::from_utf8_lossy(target), e);
+                    return None;
+                }
+            },
+            b"ASCIIHexDecode" | b"AHx" => {
+                match decode_ascii_hex(&data) {
+                    Some(d) => data = d,
+                    None => {
+                        log::warn!("ASCIIHex decode before {:?} failed", String::from_utf8_lossy(target));
+                        return None;
+                    }
+                }
+            }
+            other => {
+                log::warn!("unsupported preceding filter {:?} before {:?}", String::from_utf8_lossy(other), String::from_utf8_lossy(target));
+                return None;
+            }
+        }
+    }
+    Some(data)
+}
+
+fn get_decode_parms_dict(
+    dict: &Dictionary,
+    filters: &[Vec<u8>],
+    needle: &[u8],
+    doc: &Document,
+) -> Option<Dictionary> {
+    let idx = filter_index(filters, needle)?;
+    let parms_obj = dict.get(b"DecodeParms").ok()?;
+    let (_, resolved) = doc.dereference(parms_obj).ok()?;
+    match resolved {
+        Object::Dictionary(d) => Some(d.clone()),
+        Object::Array(arr) => {
+            if idx >= arr.len() {
+                return None;
+            }
+            let elem = &arr[idx];
+            let (_, elem_resolved) = doc.dereference(elem).ok()?;
+            match elem_resolved {
+                Object::Dictionary(d) => Some(d.clone()),
+                Object::Null => None,
+                _ => None,
+            }
+        }
+        Object::Null => None,
+        _ => None,
+    }
+}
+
+fn decoded_stream_bytes(stream: &Stream) -> Option<Vec<u8>> {
+    let filters = get_filter_names(&stream.dict);
+    if filters.is_empty() {
+        return Some(stream.content.clone());
+    }
+    let mut data = stream.content.clone();
+    for f in &filters {
+        match f.as_slice() {
+            b"ASCIIHexDecode" | b"AHx" => {
+                data = decode_ascii_hex(&data)?;
+            }
+            b"ASCII85Decode" | b"A85" => {
+                data = decode_ascii85(&data).ok()?;
+            }
+            b"FlateDecode" | b"Fl" => {
+                use flate2::read::ZlibDecoder;
+                use std::io::Read;
+                let mut dec = ZlibDecoder::new(data.as_slice());
+                let mut out = Vec::new();
+                if dec.read_to_end(&mut out).is_err() {
+                    log::warn!("Flate decode failed in stream");
+                    return None;
+                }
+                data = out;
+            }
+            b"LZWDecode" | b"LZW" => {
+                log::warn!("LZW not supported in stream");
+                return None;
+            }
+            other => {
+                log::warn!("unsupported filter {:?} in stream", String::from_utf8_lossy(other));
+                return None;
+            }
+        }
+    }
+    Some(data)
+}
+
+fn get_jbig2_globals(
+    dict: &Dictionary,
+    filters: &[Vec<u8>],
+    doc: &Document,
+) -> Option<Vec<u8>> {
+    // JBIG2Globals lives inside DecodeParms array/dict
+    let target = if filter_contains(filters, b"JBIG2Decode") {
+        b"JBIG2Decode".as_slice()
+    } else if filter_contains(filters, b"JB2Decode") {
+        b"JB2Decode".as_slice()
+    } else {
+        return None;
+    };
+    let parms = get_decode_parms_dict(dict, filters, target, doc)?;
+    let globals_obj = parms.get(b"JBIG2Globals").ok()?;
+    // Try to dereference to get the stream object
+    if let Ok((_, resolved)) = doc.dereference(globals_obj) {
+        match resolved {
+            Object::Stream(s) => return decoded_stream_bytes(s),
+            Object::Reference(id) => {
+                if let Ok(Object::Stream(s)) = doc.get_object(*id) {
+                    return decoded_stream_bytes(s);
+                }
+            }
+            _ => {}
+        }
+    }
+    // Fallback: globals_obj is directly a Reference
+    if let Ok(oid) = globals_obj.as_reference() {
+        if let Ok(Object::Stream(s)) = doc.get_object(oid) {
+            return decoded_stream_bytes(s);
+        }
+    }
+    None
+}
+
+fn decode_ccitt(
+    data: &[u8],
+    width: u32,
+    height: u32,
+    parms: Option<&Dictionary>,
+) -> Option<Vec<u8>> {
+    let k = parms.and_then(|d| get_i32(d, b"K")).unwrap_or(0);
+    let columns = parms.and_then(|d| get_u32(d, b"Columns")).unwrap_or(width);
+    let rows_param = parms.and_then(|d| get_u32(d, b"Rows")).unwrap_or(0);
+    let rows = rows_param.max(height);
+    let end_of_block = parms.and_then(|d| get_bool(d, b"EndOfBlock")).unwrap_or(true);
+    let end_of_line = parms.and_then(|d| get_bool(d, b"EndOfLine")).unwrap_or(false);
+    let encoded_byte_align = parms.and_then(|d| get_bool(d, b"EncodedByteAlign")).unwrap_or(false);
+    let black_is_1 = parms.and_then(|d| get_bool(d, b"BlackIs1")).unwrap_or(false);
+
+    if columns == 0 || rows == 0 {
+        log::warn!("CCITT invalid dimensions columns={} rows={}", columns, rows);
+        return None;
+    }
+    // Cap at ~32Mpix to avoid OOM (3GB wasm)
+    let total_pixels = (columns as u64).checked_mul(rows as u64)?;
+    if total_pixels > 32_000_000 {
+        log::warn!("CCITT image too large {}x{} ({} pixels), skipping", columns, rows, total_pixels);
+        return None;
+    }
+    let output_len = (columns as usize).checked_mul(rows as usize)?;
+    if output_len > 128 * 1024 * 1024 {
+        log::warn!("CCITT output too large {} bytes, skipping", output_len);
+        return None;
+    }
+
+    let encoding = if k < 0 {
+        hayro_ccitt::EncodingMode::Group4
+    } else if k == 0 {
+        hayro_ccitt::EncodingMode::Group3_1D
+    } else {
+        hayro_ccitt::EncodingMode::Group3_2D { k: k as u32 }
+    };
+
+    let settings = hayro_ccitt::DecodeSettings {
+        columns,
+        rows,
+        end_of_block,
+        end_of_line,
+        rows_are_byte_aligned: encoded_byte_align,
+        encoding,
+        invert_black: black_is_1,
+    };
+
+    struct Luma8Decoder {
+        output: Vec<u8>,
+        idx: usize,
+        decoded_rows: u32,
+    }
+    impl hayro_ccitt::Decoder for Luma8Decoder {
+        fn push_pixel(&mut self, white: bool) {
+            if !white {
+                if self.idx < self.output.len() {
+                    self.output[self.idx] = 0x00;
+                }
+            }
+            self.idx += 1;
+        }
+        fn push_pixel_chunk(&mut self, white: bool, chunk_count: u32) {
+            let count = chunk_count as usize * 8;
+            if !white {
+                let end = (self.idx + count).min(self.output.len());
+                if self.idx < end {
+                    self.output[self.idx..end].fill(0x00);
+                }
+            }
+            self.idx += count;
+        }
+        fn next_line(&mut self) {
+            self.decoded_rows += 1;
+        }
+    }
+
+    let mut decoder = Luma8Decoder {
+        output: vec![0xFF; output_len],
+        idx: 0,
+        decoded_rows: 0,
+    };
+    let mut ctx = hayro_ccitt::DecoderContext::new(settings);
+    let result = hayro_ccitt::decode(data, &mut decoder, &mut ctx);
+    if result.is_err() && decoder.decoded_rows == 0 {
+        log::warn!("CCITT decode failed: {:?}", result.err());
+        return None;
+    }
+    if result.is_err() {
+        // Truncate to actual decoded rows
+        let actual_len = (decoder.decoded_rows as usize) * (columns as usize);
+        if actual_len < decoder.output.len() {
+            decoder.output.truncate(actual_len);
+        } else {
+            decoder.output.truncate(decoder.idx.min(decoder.output.len()));
+        }
+        if decoder.output.is_empty() {
+            return None;
+        }
+        // If we truncated, we need to adjust rows for PNG encoding.
+        // The caller will use decoder.decoded_rows as height if it differs.
+        // For now we return the buffer and caller can compute height.
+        // To keep API simple, we return the buffer and let caller use columns x decoded_rows.
+        // But we don't have a way to return height; we assume caller will use rows if fully decoded.
+        // We'll just return truncated buffer; caller should check length.
+    }
+    // If we decoded fewer rows than expected, the buffer length tells us.
+    // Return the buffer as-is; caller will derive height from len / columns.
+    Some(decoder.output)
+}
+
+fn decode_jbig2(
+    data: &[u8],
+    globals: Option<&[u8]>,
+    width: u32,
+    height: u32,
+) -> Option<(Vec<u8>, u32, u32)> {
+    let image = hayro_jbig2::Image::new_embedded(data, globals).ok()?;
+    let w = image.width();
+    let h = image.height();
+    if w == 0 || h == 0 || w > 10000 || h > 10000 {
+        log::warn!("JBIG2 invalid dimensions {}x{}", w, h);
+        return None;
+    }
+    let total = (w as u64) * (h as u64);
+    if total > 32_000_000 {
+        log::warn!("JBIG2 image too large {}x{} ({} pixels), skipping", w, h, total);
+        return None;
+    }
+    if total as usize > 128 * 1024 * 1024 {
+        log::warn!("JBIG2 output too large {} bytes, skipping", total);
+        return None;
+    }
+    // Use Luma8 path: white=0xFF, black=0x00
+    struct Luma8Decoder {
+        output: Vec<u8>,
+        pos: usize,
+    }
+    impl hayro_jbig2::Decoder for Luma8Decoder {
+        fn push_pixel(&mut self, black: bool) {
+            if black {
+                if self.pos < self.output.len() {
+                    self.output[self.pos] = 0x00;
+                }
+            }
+            self.pos += 1;
+        }
+        fn push_pixel_chunk(&mut self, black: bool, chunk_count: u32) {
+            let count = chunk_count as usize * 8;
+            if black {
+                let end = (self.pos + count).min(self.output.len());
+                if self.pos < end {
+                    self.output[self.pos..end].fill(0x00);
+                }
+            }
+            self.pos += count;
+        }
+        fn next_line(&mut self) {}
+    }
+    // If dimensions from JBIG2 differ from PDF dict, trust JBIG2 but warn.
+    if w != width || h != height {
+        log::warn!("JBIG2 dimensions {}x{} differ from PDF {}x{}", w, h, width, height);
+    }
+    let mut decoder = Luma8Decoder {
+        output: vec![0xFF; (w as usize) * (h as usize)],
+        pos: 0,
+    };
+    image.decode(&mut decoder).ok()?;
+    Some((decoder.output, w, h))
+}
+
+pub fn extract_images(bytes: &[u8]) -> Vec<RawImage> {
+    let doc = match Document::load_mem(bytes) {
+        Ok(d) => d,
+        Err(e) => {
+            log::warn!("pdf_images: load_mem failed: {}", e);
+            return Vec::new();
+        }
+    };
+    let mut out = Vec::new();
+    let mut seen: std::collections::HashSet<lopdf::ObjectId> = std::collections::HashSet::new();
+
+    for (obj_id, obj) in &doc.objects {
+        let stream = match obj {
+            Object::Stream(s) => s,
+            _ => continue,
+        };
+        // Must be an Image XObject
+        let is_image = stream
+            .dict
+            .get(b"Subtype")
+            .ok()
+            .and_then(|o| o.as_name().ok())
+            .map(|n| n == b"Image")
+            .unwrap_or(false);
+        if !is_image {
+            continue;
+        }
+        if !seen.insert(*obj_id) {
+            continue;
+        }
+
+        let width = match get_u32(&stream.dict, b"Width") {
+            Some(v) if v > 0 && v < 10000 => v,
+            _ => {
+                log::warn!("pdf_images: image {:?} has invalid Width", obj_id);
+                continue;
+            }
+        };
+        let height = match get_u32(&stream.dict, b"Height") {
+            Some(v) if v > 0 && v < 10000 => v,
+            _ => {
+                log::warn!("pdf_images: image {:?} has invalid Height", obj_id);
+                continue;
+            }
+        };
+        // Reject huge images (cap at ~32Mpix or 32MiB raw)
+        let bpc = get_u32(&stream.dict, b"BitsPerComponent").unwrap_or(8);
+        let cs_name = get_colorspace_name(&stream.dict);
+        let filters = get_filter_names(&stream.dict);
+
+        // Passthrough JPEG / JP2
+        if filter_contains(&filters, b"DCTDecode") || filter_contains(&filters, b"DCT") {
+            let key: &[u8] = if filter_contains(&filters, b"DCTDecode") { b"DCTDecode" } else { b"DCT" };
+            if let Some(jpeg) = extract_passthrough_bytes(stream, &filters, key) {
+                // Validate JPEG magic
+                if jpeg.len() >= 2 && jpeg[0] == 0xFF && jpeg[1] == 0xD8 {
+                    out.push(RawImage {
+                        bytes: jpeg,
+                        media_type: "image/jpeg".to_string(),
+                        width,
+                        height,
+                    });
+                } else {
+                    // Still treat as jpeg; some DCT streams omit SOI? keep
+                    log::warn!("pdf_images: DCT image {:?} missing JPEG SOI, still emitting", obj_id);
+                    out.push(RawImage {
+                        bytes: jpeg,
+                        media_type: "image/jpeg".to_string(),
+                        width,
+                        height,
+                    });
+                }
+            }
+            continue;
+        }
+        if filter_contains(&filters, b"JPXDecode") {
+            if let Some(jp2) = extract_passthrough_bytes(stream, &filters, b"JPXDecode") {
+                // JPEG2000 magic: 00 00 00 0C 6A 50 20 20 or FF 4F FF 51
+                out.push(RawImage {
+                    bytes: jp2,
+                    media_type: "image/jp2".to_string(),
+                    width,
+                    height,
+                });
+            }
+            continue;
+        }
+        // CCITTFaxDecode (Group 3/4) via hayro-ccitt
+        if filter_contains(&filters, b"CCITTFaxDecode") || filter_contains(&filters, b"CCF") {
+            let target = if filter_contains(&filters, b"CCITTFaxDecode") { b"CCITTFaxDecode".as_slice() } else { b"CCF".as_slice() };
+            let data = match decode_preceding_filters(stream, &filters, target) {
+                Some(d) => d,
+                None => {
+                    log::warn!("pdf_images: CCITTFax image {:?} preceding filter decode failed", obj_id);
+                    continue;
+                }
+            };
+            let parms = get_decode_parms_dict(&stream.dict, &filters, target, &doc);
+            match decode_ccitt(&data, width, height, parms.as_ref()) {
+                Some(decoded) => {
+                    // decoded is luma8 buffer; may be larger than width*height if Columns != width or truncated
+                    let columns = parms.as_ref().and_then(|d| get_u32(d, b"Columns")).unwrap_or(width);
+                    let expected_rows = parms.as_ref().and_then(|d| get_u32(d, b"Rows")).unwrap_or(0).max(height);
+                    // Derive actual height from decoded length
+                    let actual_height = if decoded.len() % (columns as usize) == 0 {
+                        (decoded.len() / (columns as usize)) as u32
+                    } else {
+                        expected_rows
+                    };
+                    let png_w = columns;
+                    let png_h = if actual_height > 0 { actual_height } else { expected_rows };
+                    // Ensure dimensions sane
+                    if png_w == 0 || png_h == 0 || png_w > 10000 || png_h > 10000 {
+                        log::warn!("pdf_images: CCITT decoded dimensions invalid {}x{:?}", png_w, png_h);
+                        continue;
+                    }
+                    // If decoded length matches png_w*png_h, encode; else try with width/height
+                    let to_encode: Option<Vec<u8>> = if decoded.len() == (png_w as usize) * (png_h as usize) {
+                        encode_png(png_w, png_h, &decoded, 1)
+                    } else if decoded.len() == (width as usize) * (height as usize) {
+                        encode_png(width, height, &decoded, 1)
+                    } else {
+                        // Fallback: try to encode with columns x (len/columns)
+                        if decoded.len() % (png_w as usize) == 0 {
+                            let h2 = (decoded.len() / (png_w as usize)) as u32;
+                            encode_png(png_w, h2, &decoded, 1)
+                        } else {
+                            None
+                        }
+                    };
+                    if let Some(png) = to_encode {
+                        out.push(RawImage {
+                            bytes: png,
+                            media_type: "image/png".to_string(),
+                            width: png_w,
+                            height: png_h,
+                        });
+                    } else {
+                        log::warn!("pdf_images: CCITT image {:?} encode_png failed (decoded {} bytes)", obj_id, decoded.len());
+                    }
+                }
+                None => {
+                    log::warn!("pdf_images: CCITTFax image {:?} decode failed", obj_id);
+                }
+            }
+            continue;
+        }
+        if filter_contains(&filters, b"JBIG2Decode") || filter_contains(&filters, b"JB2Decode") {
+            let target = if filter_contains(&filters, b"JBIG2Decode") { b"JBIG2Decode".as_slice() } else { b"JB2Decode".as_slice() };
+            let data = match decode_preceding_filters(stream, &filters, target) {
+                Some(d) => d,
+                None => {
+                    log::warn!("pdf_images: JBIG2 image {:?} preceding filter decode failed", obj_id);
+                    continue;
+                }
+            };
+            let globals = get_jbig2_globals(&stream.dict, &filters, &doc);
+            match decode_jbig2(&data, globals.as_deref(), width, height) {
+                Some((decoded, w, h)) => {
+                    if let Some(png) = encode_png(w, h, &decoded, 1) {
+                        out.push(RawImage {
+                            bytes: png,
+                            media_type: "image/png".to_string(),
+                            width: w,
+                            height: h,
+                        });
+                    } else {
+                        log::warn!("pdf_images: JBIG2 image {:?} encode_png failed", obj_id);
+                    }
+                }
+                None => {
+                    log::warn!("pdf_images: JBIG2 image {:?} decode failed", obj_id);
+                }
+            }
+            continue;
+        }
+
+        // For Flate (and possibly ASCII85+Flate) try via lopdf's decompressed_content
+        // This handles predictor/palette via its internal png decode.
+        let is_flate = filter_contains(&filters, b"FlateDecode") || filter_contains(&filters, b"Fl");
+        if is_flate || filters.is_empty() {
+            // Use lopdf's decompression horn: clone stream and try
+            let mut s = stream.clone();
+            let decompressed = match s.decompressed_content() {
+                Ok(d) => d,
+                Err(e) => {
+                    log::warn!("pdf_images: flate image {:?} decompress failed: {:?}", obj_id, e);
+                    continue;
+                }
+            };
+            // Now `decompressed` is raw samples.
+            // Determine channels from ColorSpace and bpc
+            let channels: usize = match cs_name.as_str() {
+                "DeviceRGB" | "DeviceRgb" => 3,
+                "DeviceGray" | "DeviceGrey" => 1,
+                "" => {
+                    // No ColorSpace -> assume Gray for 1bpc or RGB for 3
+                    // Heuristic: if bytes == w*h*3 -> RGB else Gray
+                    if decompressed.len() == (width as usize * height as usize * 3) {
+                        3
+                    } else if decompressed.len() == (width as usize * height as usize) {
+                        1
+                    } else {
+                        log::warn!("pdf_images: unknown ColorSpace for image {:?}, guessing", obj_id);
+                        3
+                    }
+                }
+                "Indexed" => {
+                    // Try Indexed palette decode first
+                    if let Some(info) = parse_indexed(&doc, &stream.dict) {
+
+                        if bpc != 1 && bpc != 2 && bpc != 4 && bpc != 8 {
+                            log::warn!("pdf_images: Indexed BPC={} for image {:?} skipped", bpc, obj_id);
+                            continue;
+                        }
+                        if let Some(indices) = unpack_indices(&decompressed, width, height, bpc) {
+                            if let Some(rgb) = lookup_to_rgb(&indices, &info, width, height) {
+                                if let Some(png) = encode_png(width, height, &rgb, 3) {
+                                    out.push(RawImage { bytes: png, media_type: "image/png".to_string(), width, height });
+                                    continue;
+                                }
+                            }
+                        }
+                        log::warn!("pdf_images: Indexed decode failed for image {:?}", obj_id);
+                    } else {
+                        log::warn!("pdf_images: Indexed ColorSpace for image {:?} parse failed", obj_id);
+                    }
+                    continue;
+                }
+                other if other.contains("CMYK") || other == "DeviceCMYK" => {
+                    if bpc != 8 {
+                        log::warn!("pdf_images: CMYK BPC={} for image {:?} skipped", bpc, obj_id);
+                        continue;
+                    }
+                    let expected = (width as usize) * (height as usize) * 4;
+                    if decompressed.len() < expected {
+                        log::warn!("pdf_images: CMYK image {:?} decompressed {} < expected {} truncated", obj_id, decompressed.len(), expected);
+                        continue;
+                    }
+                    let trimmed = &decompressed[..expected];
+                    let mut rgb = Vec::with_capacity((width as usize)*(height as usize)*3);
+                    for chunk in trimmed.chunks_exact(4) {
+                        let (r,g,b) = cmyk_to_rgb_naive(chunk[0], chunk[1], chunk[2], chunk[3]);
+                        rgb.extend_from_slice(&[r,g,b]);
+                    }
+                    if let Some(png) = encode_png(width, height, &rgb, 3) {
+                        out.push(RawImage { bytes: png, media_type: "image/png".to_string(), width, height });
+                    } else {
+                        log::warn!("pdf_images: CMYK encode_png failed for image {:?}", obj_id);
+                    }
+                    continue;
+                }
+                other => {
+                    log::warn!("pdf_images: ColorSpace {:?} for image {:?} skipped", other, obj_id);
+                    continue;
+                }
+            };
+
+            // Validate BPC: MVP only 8
+            if bpc != 8 {
+                // 1/2/4 bpc need bit unpacking; skip for MVP
+                if bpc == 1 && channels == 1 {
+                    // 1bpc bilevel via Flate: each byte holds 8 pixels.
+                    // Expand to 8-bit gray then encode via PNG.
+                    let row_bytes = ((width as usize * bpc as usize + 7) / 8) as usize;
+                    if decompressed.len() < row_bytes * height as usize {
+                        log::warn!("pdf_images: 1bpc image {:?} truncated", obj_id);
+                        continue;
+                    }
+                    let mut expanded = Vec::with_capacity(width as usize * height as usize);
+                    for y in 0..height as usize {
+                        let row = &decompressed[y * row_bytes..(y + 1) * row_bytes];
+                        for x in 0..width as usize {
+                            let byte = row[x / 8];
+                            let bit = 7 - (x % 8);
+                            let v = (byte >> bit) & 1;
+                            expanded.push(if v == 0 { 0u8 } else { 255u8 });
+                        }
+                    }
+                    if let Some(png) = encode_png(width, height, &expanded, 1) {
+                        out.push(RawImage {
+                            bytes: png,
+                            media_type: "image/png".to_string(),
+                            width,
+                            height,
+                        });
+                    }
+                    continue;
+                }
+                log::warn!("pdf_images: BPC={} for image {:?} skipped (MVP only 8 or 1/gray)", bpc, obj_id);
+                continue;
+            }
+
+            let expected = width as usize * height as usize * channels;
+            if decompressed.len() < expected {
+                log::warn!(
+                    "pdf_images: flate image {:?} decompressed {} < expected {} ({}x{}x{})",
+                    obj_id,
+                    decompressed.len(),
+                    expected,
+                    width,
+                    height,
+                    channels
+                );
+                continue;
+            }
+            // Trim to expected (some streams have extra predictor padding already removed)
+            let trimmed = &decompressed[..expected];
+            if let Some(png) = encode_png(width, height, trimmed, channels) {
+                out.push(RawImage {
+                    bytes: png,
+                    media_type: "image/png".to_string(),
+                    width,
+                    height,
+                });
+            } else {
+                log::warn!("pdf_images: encode_png failed for image {:?}", obj_id);
+            }
+            continue;
+        }
+
+        // Other filters (LZW, RunLength, etc.) – skip with warn for MVP
+        log::warn!("pdf_images: image {:?} with filters {:?} skipped (MVP)", obj_id, filters);
+    }
+
+    out
+}
