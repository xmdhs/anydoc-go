index 0000000..04aad65
--- /dev/null
+++ b/internal/gcasm/transform_a64_hyphen_test.go
@@ -0,0 +1,32 @@
+package gcasm
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestA64RewriteSlotsHyphenatedImport(t *testing.T) {
+	opts := TransformOptions{
+		ArgNames: []string{"m"},
+		ResName:  "l0",
+	}
+	args := []RegAssignment{{Kind: ArgI64, StackOf: 0}}
+	got := a64RewriteSlots(
+		"MOVD anydoc-go/core/p0.m+0(FP), R0\n"+
+			"MOVD anydoc-go/core/p0.l0+8(FP), R1\n"+
+			"MOVD anydoc-go/core/p0.buf-248(SP), R2",
+		256, 16, args, opts,
+	)
+
+	for _, want := range []string{"m+0(FP)", "l0+8(FP)", "32(RSP)"} {
+		if !strings.Contains(got, want) {
+			t.Fatalf("rewritten slots missing %q:\n%s", want, got)
+		}
+	}
+	if strings.Contains(got, "anydoc-") {
+		t.Fatalf("hyphenated import prefix leaked into rewritten slots:\n%s", got)
+	}
+	if strings.Contains(got, "buf-248(SP)") {
+		t.Fatalf("negative virtual-SP offset was not rewritten:\n%s", got)
+	}
+}
